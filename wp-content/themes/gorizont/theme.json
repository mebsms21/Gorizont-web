{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "paper",
          "name": "Белый",
          "color": "#ffffff"
        },
        {
          "slug": "white",
          "name": "Белый",
          "color": "#ffffff"
        },
        {
          "slug": "ink",
          "name": "Графит",
          "color": "#202833"
        },
        {
          "slug": "muted",
          "name": "Серый текст",
          "color": "#586171"
        },
        {
          "slug": "accent",
          "name": "Фирменный оранжевый",
          "color": "#ff6500"
        },
        {
          "slug": "line",
          "name": "Светло-серый",
          "color": "#e5e8ed"
        },
        {
          "slug": "sand",
          "name": "Фоновый серый",
          "color": "#f4f5f7"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "vw",
        "%"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "30",
          "name": "S",
          "size": "1.25rem"
        },
        {
          "slug": "40",
          "name": "M",
          "size": "2rem"
        },
        {
          "slug": "50",
          "name": "L",
          "size": "3rem"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "clamp(3rem,7vw,7rem)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Manrope",
          "fontFamily": "Manrope, Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/manrope.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Мелкий",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Основной",
          "size": "1.0625rem"
        },
        {
          "slug": "large",
          "name": "Крупный",
          "size": "1.5rem"
        },
        {
          "slug": "x-large",
          "name": "Заголовок раздела",
          "size": "2.6rem",
          "fluid": {
            "min": "1.9rem",
            "max": "2.6rem"
          }
        },
        {
          "slug": "hero",
          "name": "Главный заголовок",
          "size": "4.8rem",
          "fluid": {
            "min": "2.65rem",
            "max": "4.8rem"
          }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "1rem",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1.25rem,4vw,4rem)",
        "right": "clamp(1.25rem,4vw,4rem)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "750",
          "lineHeight": "1.06",
          "letterSpacing": "-0.045em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|ink"
        },
        "border": {
          "radius": "50px"
        },
        "typography": {
          "fontSize": ".9rem",
          "fontWeight": "650"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "1.5rem",
            "bottom": "1rem",
            "left": "1.5rem"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "1.35rem",
          "fontWeight": "800",
          "letterSpacing": "-0.06em"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|line"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Шапка сайта",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Подвал сайта",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "canvas",
      "title": "Страница без заголовка",
      "postTypes": [
        "page"
      ]
    }
  ]
}
